-- Write your PostgreSQL query statement below
WITH rank AS(
    SELECT product_id, new_price, change_date, ROW_NUMBER() OVER(PARTITION BY product_id ORDER BY change_date DESC) as rn
    FROM Products
    WHERE change_date <= '2019-08-16'
),

row_status AS(
    SELECT
        product_id, new_price, 
        CASE WHEN 
            change_date IN (
            SELECT change_date
            FROM rank 
            WHERE a.product_id = product_id AND rn = 1)
        THEN true
        ELSE NULL
        END as status
    FROM products a
)


SELECT product_id, COALESCE(MAX(new_price) FILTER(WHERE status IS NOT NULL),10) as price 
FROM row_status
GROUP BY product_id
